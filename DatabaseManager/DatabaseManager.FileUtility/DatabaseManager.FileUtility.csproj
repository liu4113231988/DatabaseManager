<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>2.0.2</Version>
    <Authors>victor-wiki</Authors>
    <Description>Read and write CSV and Excel.</Description>
    <PackageProjectUrl>https://github.com/victor-wiki/DatabaseManager</PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
    <AssemblyVersion>2.0.2</AssemblyVersion>
    <FileVersion>2.0.2</FileVersion>
    <PackageReleaseNotes>add: WordWriter.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NPOI" />
    <!-- Keep NPOI cryptography dependencies on the current security patch. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>
