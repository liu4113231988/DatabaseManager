<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DatabaseManager.Avalonia.Controls.SqlEditor">

    <!-- SQL 编辑器：AvaloniaEdit（非 AtomUI 主题控件，浅色配色完全自绘，不会被 pointerover 等状态样式覆盖） -->
    <Border Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
        <ae:TextEditor x:Name="PART_TextEditor"
                       Background="#FFFFFF"
                       Foreground="#1F1F1F"
                       FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                       FontSize="13"
                       Padding="6,4"
                       WordWrap="False"
                       ShowLineNumbers="True"
                       LineNumbersForeground="#A0A0A0"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </Border>

</UserControl>
