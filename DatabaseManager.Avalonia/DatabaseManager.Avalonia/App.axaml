<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DatabaseManager.Avalonia.App"
			 xmlns:local="using:DatabaseManager.Avalonia"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<!-- 基础主题；AtomUI 在 App.OnFrameworkInitializationCompleted 中通过 UseAtomUI 覆盖为 Ant Design 风格 -->
		<FluentTheme />
		<!-- AvaloniaEdit 控件主题（必须引入，否则 TextEditor 无模板：黑块且无法输入） -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
		<!-- DataGrid 控件主题（必须引入，否则结果表格无模板、完全不可见） -->
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

		<!-- DatabaseManager visual language: restrained, high-contrast and optimised for dense daily work. -->
		<Style Selector="Window">
			<Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Segoe UI, sans-serif" />
			<Setter Property="Background" Value="#F7F9FC" />
			<Setter Property="Foreground" Value="#172033" />
		</Style>
		<Style Selector="TextBox, ComboBox">
			<Setter Property="MinHeight" Value="32" />
		</Style>
		<Style Selector="Button">
			<Setter Property="MinHeight" Value="32" />
			<!-- 小字号密集按钮在 32px 高度下文字偏上，统一垂直居中，避免底部留白偏大 -->
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<!-- 紧凑按钮：用于查询结果区/分页栏等密集小按钮（FontSize 11 场景） -->
		<Style Selector="Button.compact">
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.toolbar">
			<Setter Property="MinWidth" Value="32" />
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="Padding" Value="7" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Button.toolbar:pointerover">
			<Setter Property="Background" Value="#EAF2FF" />
			<Setter Property="BorderBrush" Value="#C9DEFF" />
		</Style>
		<Style Selector="Border.surface">
			<Setter Property="Background" Value="#FFFFFF" />
			<Setter Property="BorderBrush" Value="#E3E8F0" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
	</Application.Styles>

</Application>
