<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\database-manager.ico</ApplicationIcon>
    <RootNamespace>DatabaseManager.Avalonia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- SQL 高亮定义：以托管嵌入资源形式打包（SqlEditor 通过 GetManifestResourceStream 加载） -->
    <AvaloniaResource Remove="Assets\Sql.xshd" />
    <EmbeddedResource Include="Assets\Sql.xshd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12.x：生态兼容基座（AtomUI / Dock / MessageBox 均基于 Avalonia 12） -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />

    <!-- 表格：查询结果网格 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <!-- SQL 编辑器：AvaloniaEdit（Avalonia 12 对应 12.0.0） -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />

    <!-- MVVM / DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- 主题：AtomUI.Desktop.Controls（Ant Design 风格，对齐原 AntdUI 视觉）；6.x 基于 Avalonia 12 -->
    <PackageReference Include="AtomUI.Desktop.Controls" Version="6.1.5" />

    <!-- 停靠布局：Dock -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.4" />

    <!-- 消息框 -->
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppCore 业务层（UI 无关） -->
    <ProjectReference Include="..\DatabaseManager.AppCore\DatabaseManager.AppCore.csproj" />
  </ItemGroup>

</Project>
