<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\database-manager.ico</ApplicationIcon>
    <RootNamespace>DatabaseManager.Avalonia</RootNamespace>
    <!-- 仅保留 win-x64 与 linux-x64 运行时，避免发布包携带大量其他平台原生依赖 -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
	  <SatelliteResourceLanguages>zh-Hans;es;</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- SQL 高亮定义：以托管嵌入资源形式打包（SqlEditor 通过 GetManifestResourceStream 加载） -->
    <AvaloniaResource Remove="Assets\Sql.xshd" />
    <EmbeddedResource Include="Assets\Sql.xshd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12.x：生态兼容基座（AtomUI / Dock / MessageBox 均基于 Avalonia 12） -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />

    <!-- 表格：查询结果网格 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <!-- SQL 编辑器：AvaloniaEdit（Avalonia 12 对应 12.0.0） -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />

    <!-- MVVM / DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- 主题：AtomUI.Desktop.Controls（Ant Design 风格，对齐原 AntdUI 视觉）；6.x 基于 Avalonia 12 -->
    <PackageReference Include="AtomUI.Desktop.Controls" Version="6.1.5" />

    <!-- 停靠布局：Dock -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.4" />

    <!-- 消息框 -->
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppCore 业务层（UI 无关） -->
    <ProjectReference Include="..\DatabaseManager.AppCore\DatabaseManager.AppCore.csproj" />
  </ItemGroup>

  <!--
    构建后清理：仅保留 win-x64 与 linux-x64 运行时目录，删除其他平台原生依赖以减小输出体积。
    dotnet build 阶段 NuGet 会将所有受支持平台的原生依赖复制到 runtimes/，需要手动剔除。
    同时清理 runtimes/ 下残留的 pdb 调试符号文件。
  -->
  <Target Name="RemoveUnwantedRuntimes" AfterTargets="Build">
    <ItemGroup>
      <_UnwantedRuntimes Include="browser-wasm;linux;linux-arm;linux-arm64;linux-armel;linux-bionic-arm64;linux-bionic-x64;linux-loongarch64;linux-mips64;linux-musl-arm;linux-musl-arm64;linux-musl-loongarch64;linux-musl-riscv64;linux-musl-s390x;linux-musl-x64;linux-ppc64le;linux-riscv64;linux-s390x;linux-x86;maccatalyst-arm64;maccatalyst-x64;osx;osx-arm64;osx-x64;unix;win;win-arm;win-arm64;win-x86" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnwantedRuntimes->'$(OutDir)runtimes\%(Identity)')" Condition="Exists('$(OutDir)runtimes\%(Identity)')" />
    <!-- 清理 runtimes/ 下所有 pdb 调试符号文件（保留 dll/so/dylib 等运行时资产） -->
    <ItemGroup>
      <_RuntimePdbFiles Include="$(OutDir)runtimes\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_RuntimePdbFiles)" />
  </Target>

</Project>
