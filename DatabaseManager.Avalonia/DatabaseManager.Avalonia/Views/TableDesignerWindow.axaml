<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.TableDesignerWindow"
        x:DataType="vm:TableDesignerViewModel"
        Title="表设计器"
        Width="1020" Height="680" MinWidth="900" MinHeight="560"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <!-- VS/SSMS 风格：标题区（含模式胶囊）+ 表信息卡 + 工具栏 + Tabs + 蓝条状态条 -->
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">

        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="表设计器" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <Border CornerRadius="3" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource AppNodeBadgeBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="新建表" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppWarningBrush}"
                                           IsVisible="{Binding IsNew}" />
                                <TextBlock Text="编辑表" FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           IsVisible="{Binding !IsNew}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="3" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource AppHighlightBrush}"
                                IsVisible="{Binding HasChanges}">
                            <TextBlock Text="● 未保存" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppWarningBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="可视化编辑表结构、列、主键与约束" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="表设计器" Foreground="{DynamicResource AppStatusBarTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource AppStatusBarSecondaryTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DatabaseName}" Foreground="{DynamicResource AppStatusBarTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource AppStatusBarSecondaryTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TableName}" Foreground="{DynamicResource AppStatusBarTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="● 有未保存更改" Foreground="{DynamicResource AppHighlightBrush}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsVisible="{Binding HasChanges}" />
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <DockPanel Margin="16,12,16,12">

            <!-- 表信息卡 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="14,10,14,8" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,170,Auto,*,Auto,200">
                        <TextBlock Text="表名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                        <atom:TextBox Grid.Column="1" Text="{Binding TableName}" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Schema" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                        <atom:TextBox Grid.Column="3" Text="{Binding Schema}" VerticalContentAlignment="Center"
                                      Margin="8,0,0,0" />
                        <TextBlock Grid.Column="4" Text="注释" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                        <atom:TextBox Grid.Column="5" Text="{Binding Comment}" VerticalContentAlignment="Center"
                                      Margin="8,0,0,0" />
                    </Grid>

                    <!-- 上下文与状态行 -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource AppSuccessBrush}" />
                        <TextBlock Grid.Column="1" Text="数据库" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{Binding DatabaseName}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Grid.Column="3" Text="连接" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="{Binding ConnectionName}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Grid.Column="6" Text="{Binding StatusMessage}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Grid.Column="7" Text=" ●" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppWarningBrush}"
                                   IsVisible="{Binding IsBusy}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 工具栏：主操作右置 -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <atom:Button Content="＋ 新增列" Command="{Binding AddColumnCommand}" />
                    <Separator Margin="4,0" />
                    <atom:Button Content="👁 预览脚本" Command="{Binding GeneratePreviewCommand}"
                                 IsEnabled="{Binding !IsBusy}"
                                 ToolTip.Tip="生成 CREATE/ALTER DDL 预览（不执行）" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <atom:Button Content="✓ 保存结构" ButtonType="Primary" Command="{Binding SaveCommand}"
                                 IsEnabled="{Binding !IsBusy}"
                                 ToolTip.Tip="生成并执行 DDL，保存后自动重载最新结构" />
                </StackPanel>
            </Grid>

            <!-- 底部操作条：提示 + 关闭（DockPanel 中最后一个子元素填充，故须声明在 TabControl 之前） -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           Text="提示：修改结构后点击「预览脚本」查看生成的 DDL，确认无误后点击「保存结构」执行。" />
                <atom:Button Grid.Column="1" Content="关闭" MinWidth="76" Click="BtnClose_Click" />
            </Grid>

            <!-- 主体：Tabs（DockPanel 的填充子元素，必须最后声明） -->
            <TabControl x:Name="DesignTabs" Margin="0,0,0,10">

                <!-- 列 Tab -->
                <TabItem Header="列">
                    <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Columns}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="列名" Binding="{Binding Name}" Width="1.2*" MinWidth="100"
                                                        IsReadOnly="False" />
                                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="1.1*" MinWidth="90" />
                                    <DataGridTextColumn Header="长度" Binding="{Binding MaxLength}" Width="0.55*" />
                                    <DataGridTextColumn Header="精度" Binding="{Binding Precision}" Width="0.55*" />
                                    <DataGridTextColumn Header="小数位" Binding="{Binding Scale}" Width="0.55*" />
                                    <DataGridCheckBoxColumn Header="可空" Binding="{Binding IsNullable}" Width="Auto" />
                                    <DataGridCheckBoxColumn Header="自增" Binding="{Binding IsIdentity}" Width="Auto" />
                                    <DataGridTextColumn Header="默认值" Binding="{Binding DefaultValue}" Width="1*" MinWidth="90" />
                                    <DataGridTextColumn Header="注释" Binding="{Binding Comment}" Width="1*" MinWidth="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="提示：直接在表格中编辑列定义；自增/精度等取值随数据类型校验。"
                                       FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <atom:Button Content="＋ 新增列" Command="{Binding AddColumnCommand}" />
                                <atom:Button Content="删除选中列" Click="BtnRemoveColumn_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 主键 Tab -->
                <TabItem Header="主键">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                            <TextBlock Text="主键名称" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
                            <atom:TextBox Grid.Column="1" Text="{Binding PrimaryKey.Name}"
                                          VerticalContentAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="主键列以添加顺序作为索引列顺序" VerticalAlignment="Center"
                                       FontSize="11" Opacity="0.6" Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="已选主键列" Margin="0,0,0,4" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />

                        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,8">
                            <ListBox x:Name="PkColumnList"
                                     ItemsSource="{Binding PrimaryKey.Columns}"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0">
                                            <TextBlock Text="🔑" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="未定义主键时保存将不包含主键子句。" FontSize="11" Opacity="0.6" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <atom:Button Content="＋ 添加主键列" Click="BtnPkAddColumn_Click" />
                                <atom:Button Content="－ 移除选中列" Click="BtnPkRemoveColumn_Click" />
                                <atom:Button Content="清除主键" Click="BtnPkClear_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 索引 Tab -->
                <TabItem Header="索引">
                    <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Indexes}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="索引名" Binding="{Binding Name}" Width="1.5*" MinWidth="100" />
                                    <DataGridCheckBoxColumn Header="唯一" Binding="{Binding IsUnique}" Width="Auto" />
                                    <DataGridTextColumn Header="列" Binding="{Binding ColumnsDisplay}" Width="3*" MinWidth="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                                       Text="索引列以英文逗号分隔填写，如：ColA,ColB。" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <atom:Button Content="＋ 新增索引" Command="{Binding AddIndexCommand}" />
                                <atom:Button Content="删除选中" Click="BtnRemoveIndex_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 外键 Tab -->
                <TabItem Header="外键">
                    <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding ForeignKeys}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="外键名" Binding="{Binding Name}" Width="1.2*" MinWidth="100" />
                                    <DataGridTextColumn Header="引用表" Binding="{Binding ReferencedTableName}" Width="1.5*" MinWidth="110" />
                                    <DataGridCheckBoxColumn Header="更新级联" Binding="{Binding UpdateCascade}" Width="Auto" />
                                    <DataGridCheckBoxColumn Header="删除级联" Binding="{Binding DeleteCascade}" Width="Auto" />
                                    <DataGridTextColumn Header="列映射" Binding="{Binding ColumnsDisplay}" Width="3*" MinWidth="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                                       Text="列映射格式：本表列=引用列，多组用英文逗号分隔。" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <atom:Button Content="＋ 新增外键" Command="{Binding AddForeignKeyCommand}" />
                                <atom:Button Content="删除选中" Click="BtnRemoveForeignKey_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 约束 Tab -->
                <TabItem Header="约束">
                    <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Constraints}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="约束名" Binding="{Binding Name}" Width="1.5*" MinWidth="100" />
                                    <DataGridTextColumn Header="检查表达式" Binding="{Binding Definition}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                                       Text="检查表达式示例：[Age]&gt;=0。" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <atom:Button Content="＋ 新增约束" Command="{Binding AddConstraintCommand}" />
                                <atom:Button Content="删除选中" Click="BtnRemoveConstraint_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 脚本预览 Tab -->
                <TabItem Header="脚本预览">
                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,10,0,0"
                            Background="{DynamicResource AppSubtleBrush}">
                        <atom:TextBox Text="{Binding PreviewScript}"
                                      AcceptsReturn="True"
                                      Classes="multiline"
                                      TextWrapping="NoWrap"
                                      FontFamily="Consolas, Menlo, monospace"
                                      FontSize="12"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>

</Window>
