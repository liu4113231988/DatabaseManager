<Window xmlns="https://github.com/avaloniaui" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:atom="https://atomui.net"
        xmlns:m="using:DatabaseManager.AppCore.Services"
        xmlns:mods="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.UserManagementWindow"
        Title="用户与权限管理"
        Width="1120" Height="680" MinWidth="1020" MinHeight="600"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <!-- VS/SSMS 风格布局：标题区 + 内容区 + 蓝条状态条 -->
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">
        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel Spacing="2">
                <TextBlock Text="用户与权限管理" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock x:Name="TxtScope" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <TextBlock Text="用户与权限管理" Foreground="{DynamicResource AppStatusBarTextBrush}"
                       FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- 内容区 -->
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- 连接与主要操作 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="连接:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <atom:ComboBox Grid.Column="1" x:Name="CmbConnection" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="mods:ConnectionItem">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </atom:ComboBox>
            <atom:Button Grid.Column="2" x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" Margin="0,0,8,0" />
            <atom:Button Grid.Column="3" Content="新建用户" Click="BtnCreateUser_Click" Margin="0,0,8,0" />
            <atom:Button Grid.Column="4" Content="新建角色" Click="BtnCreateRole_Click" Margin="0,0,8,0" />
            <atom:Button Grid.Column="5" Content="查看权限" Click="BtnShowGrants_Click" Margin="0,0,8,0" />
            <atom:Button Grid.Column="6" Content="关闭" Click="BtnClose_Click" />
        </Grid>

        <!-- 权限与主体管理操作 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <atom:Button Content="授权..." Click="BtnGrant_Click"
                    ToolTip.Tip="对选中主体授予对象权限（生成 SQL 并确认后执行）" />
            <atom:Button Content="撤销授权..." Click="BtnRevoke_Click"
                    ToolTip.Tip="从选中主体撤销对象权限" />
            <atom:Button Content="授予角色..." Click="BtnGrantRole_Click"
                    ToolTip.Tip="把角色授予选中的成员主体（成员关系）" />
            <atom:Button Content="撤销角色..." Click="BtnRevokeRole_Click"
                    ToolTip.Tip="从选中的成员主体撤销角色" />
            <atom:Button Content="修改密码..." Click="BtnChangePassword_Click"
                    ToolTip.Tip="修改选中主体的密码（SQL Server 为登录名）" />
            <atom:Button Content="删除主体" Click="BtnDropUser_Click"
                    ToolTip.Tip="按主体类别生成 DROP USER / DROP ROLE" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.35*,*">
            <!-- 主体列表 -->
            <DataGrid Grid.Column="0" x:Name="UsersGrid" AutoGenerateColumns="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="11"
                      IsReadOnly="True" Margin="0,0,8,0"
                      x:DataType="m:DbUserInfo">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="80" />
                    <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="72" />
                    <DataGridTextColumn Header="属性/状态" Binding="{Binding Attributes}" Width="*" MinWidth="110" />
                    <DataGridTextColumn Header="创建时间" Binding="{Binding Created}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 权限文本 -->
            <atom:TextBox Grid.Column="1" x:Name="TxtGrants" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Classes="multiline"
                     PlaceholderText="选中主体后点击「查看权限」；操作结果也显示在这里" FontSize="11" />
        </Grid>

        <!-- 表单区（新建用户 / 新建角色 / 授权 / 撤销 / 成员关系 / 改密码 共用） -->
        <Border Grid.Row="3" x:Name="FormPanel" IsVisible="False" Background="{DynamicResource AppSubtleBrush}"
                CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
            <StackPanel Spacing="6">
                <TextBlock x:Name="FormTitle" Text="新建用户" FontWeight="SemiBold" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel x:Name="PanelFormName" Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="LblFormName" Text="用户名:" VerticalAlignment="Center" FontSize="11" />
                        <atom:TextBox x:Name="TxtFormUser" Width="130" VerticalContentAlignment="Center" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PanelPassword">
                        <TextBlock Text="密码:" VerticalAlignment="Center" FontSize="11" />
                        <atom:TextBox x:Name="TxtFormPassword" Width="130" PasswordChar="*" VerticalContentAlignment="Center" FontSize="11" />
                    </StackPanel>
                    <CheckBox x:Name="ChkCanLogin" Content="可登录" IsVisible="False" VerticalAlignment="Center" FontSize="11"
                              ToolTip.Tip="PostgreSQL/KingbaseES 创建角色时是否附加 LOGIN" />
                    <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PanelHost">
                        <TextBlock x:Name="LblFormHost" Text="主机:" VerticalAlignment="Center" FontSize="11" />
                        <atom:TextBox x:Name="TxtFormHost" Text="%" Width="80" VerticalContentAlignment="Center" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PanelMember">
                        <TextBlock Text="成员:" VerticalAlignment="Center" FontSize="11" />
                        <atom:TextBox x:Name="TxtFormMember" Width="120" VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip.Tip="被授予或撤销角色的主体名称" />
                    </StackPanel>
                    <StackPanel x:Name="PanelMemberHost" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="成员主机:" VerticalAlignment="Center" FontSize="11" />
                        <atom:TextBox x:Name="TxtFormMemberHost" Width="80" VerticalContentAlignment="Center" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PanelPrivilege" IsVisible="False">
                    <TextBlock Text="权限:" VerticalAlignment="Center" FontSize="11" />
                    <atom:ComboBox x:Name="ComboPrivilege" Width="110" FontSize="11">
                        <ComboBoxItem>SELECT</ComboBoxItem>
                        <ComboBoxItem>INSERT</ComboBoxItem>
                        <ComboBoxItem>UPDATE</ComboBoxItem>
                        <ComboBoxItem>DELETE</ComboBoxItem>
                        <ComboBoxItem>ALL PRIVILEGES</ComboBoxItem>
                    </atom:ComboBox>
                    <TextBlock Text="ON 对象:" VerticalAlignment="Center" FontSize="11" />
                    <atom:TextBox x:Name="TxtFormObject" Width="160" VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip.Tip="MySQL：db.table 或 *.*；PostgreSQL/SQL Server：schema.table 或 schema.*；Oracle：schema.table" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:Button x:Name="BtnFormConfirm" Content="执行" Click="BtnFormConfirm_Click" />
                    <atom:Button Content="取消" Click="BtnFormCancel_Click" />
                    <TextBlock Text="执行前会显示操作范围和 SQL，密码会遮蔽。" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>

</Window>
