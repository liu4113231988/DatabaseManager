<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.DiagnoseWindow"
        x:DataType="vm:DiagnoseViewModel"
        Title="数据库诊断 (Diagnose)"
        Width="1000" Height="680"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <!-- VS/SSMS 风格布局：标题区 + 内容区 + 蓝条状态条 -->
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">
        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel Spacing="2">
                <TextBlock Text="数据库诊断" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="执行诊断脚本发现常见问题" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <TextBlock Text="数据库诊断" Foreground="{DynamicResource AppStatusBarTextBrush}"
                       FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- 内容区 -->
        <DockPanel Margin="16">


        <!-- 顶部：连接、诊断类型与操作 -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">

            <!-- 连接 -->
            <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Text="数据库" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboConnection" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <!-- 诊断类型 -->
            <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Text="诊断类型" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboDiagnoseType" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button Content="开始诊断" ButtonType="Primary" Command="{Binding ExecuteCommand}"
                             IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="刷新连接" Click="BtnRefresh_Click" IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="关闭" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,6,0,0" Opacity="0.75" TextWrapping="Wrap" />

        <!-- 中部：TabControl（表诊断 / 脚本诊断 / 日志） -->
        <TabControl x:Name="MainTabs">

            <!-- 表诊断页 -->
            <TabItem Header="表诊断结果">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="检出异常对象（记录数 / 定位 SQL）" FontWeight="Bold" Margin="2,0,0,4" />
                    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding TableResults}" AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding ObjectType}" />
                                <DataGridTextColumn Header="架构" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding Schema}" />
                                <DataGridTextColumn Header="表名" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding TableName}" />
                                <DataGridTextColumn Header="对象名" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding ObjectName}" />
                                <DataGridTextColumn Header="异常记录数" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding RecordCount}" />
                                <DataGridTextColumn Header="定位 SQL" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding Sql}" />
                                <DataGridTextColumn Header="完整对象名" x:DataType="models:TableDiagnoseResultItem" Binding="{CompiledBinding DisplayName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- 脚本诊断页 -->
            <TabItem Header="脚本诊断结果">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="检出异常的脚本对象及其明细" FontWeight="Bold" Margin="2,0,0,4" />
                    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding ScriptResults}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ScriptDiagnoseResultItem">
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ObjectType}" FontWeight="SemiBold" Foreground="#2980B9" />
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Opacity="0.85"
                                                               FontFamily="Consolas,Menlo,monospace"
                                                               TextWrapping="Wrap" Margin="12,0,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- 日志页 -->
            <TabItem Header="日志">
                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Logs}" IsHitTestVisible="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>
        </DockPanel>
    </DockPanel>

</Window>
