<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        xmlns:conv="using:DatabaseManager.Avalonia.Converters"
        x:Class="DatabaseManager.Avalonia.Views.SchemaCompareWindow"
        x:DataType="vm:SchemaCompareViewModel"
        Title="结构对比 (Schema Compare)"
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:DiffColorConverter x:Key="DiffColorConverter" />
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- 顶部：源/目标选择与对象类型 -->
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">

            <!-- 源/目标连接 -->
            <Grid ColumnDefinitions="110,*,40,110,*">
                <TextBlock Grid.Column="0" Text="源数据库" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboSource" Grid.Column="1" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Column="2" Text="⇄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" Text="目标数据库" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboTarget" Grid.Column="4" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 对象类型 -->
            <Grid ColumnDefinitions="110,*,*">
                <TextBlock Grid.Column="0" Text="对象类型" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboObjectType" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 执行按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button Content="执行对比" ButtonType="Primary" Command="{Binding ExecuteCommand}"
                             IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="刷新连接" Click="BtnRefresh_Click" />
                <atom:Button Content="关闭" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,6,0,0" Opacity="0.75" TextWrapping="Wrap" />

        <!-- 中部：差异树 + 详情/日志 左右分栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 差异树 -->
            <Border Grid.Column="0" Grid.Row="0"
                    BorderBrush="#22000000" BorderThickness="1" Margin="0,0,0,6">
                <TreeView ItemsSource="{Binding DifferenceRoots}"
                          SelectedItem="{Binding SelectedDifference}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="models:SchemaCompareItem"
                                          ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DifferenceTypeText}"
                                           Foreground="{Binding Converter={StaticResource DiffColorConverter}}" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" Background="#22000000" />

            <!-- 右侧：详情 + 日志 -->
            <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,6">
                <!-- 详情 -->
                <TextBlock DockPanel.Dock="Top" Text="详情" FontWeight="Bold" Margin="2,0,0,4" />
                <Border DockPanel.Dock="Top" BorderBrush="#22000000" BorderThickness="1"
                        MinHeight="90" MaxHeight="180" Margin="0,0,0,8">
                    <TextBox Text="{Binding DetailText}" IsReadOnly="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0" />
                </Border>

                <!-- 日志 -->
                <TextBlock DockPanel.Dock="Top" Text="日志" FontWeight="Bold" Margin="2,0,0,4" />
                <Border BorderBrush="#22000000" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Logs}" IsHitTestVisible="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
