<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.ConnectionManagerWindow"
        x:DataType="vm:ConnectionManagerViewModel"
        Title="连接管理"
        Width="760" Height="520"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="20" Background="{DynamicResource AppWindowBgBrush}">

        <!-- 顶部工具栏 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
              Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="数据库类型" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:ComboBox x:Name="ComboDatabaseType" Width="160" MinWidth="160"
                               SelectionChanged="ComboDatabaseType_SelectionChanged" />
            </StackPanel>

            <atom:Button Grid.Column="3" Content="刷新" Margin="6,0,0,0"
                         Click="BtnRefresh_Click" />
            <atom:Button Grid.Column="4" Content="新增" ButtonType="Primary" Margin="6,0,0,0"
                         Click="BtnAdd_Click" />
            <atom:Button Grid.Column="5" Content="编辑" Margin="6,0,0,0"
                         Click="BtnEdit_Click" />
            <atom:Button Grid.Column="6" Content="删除" Margin="6,0,0,0"
                         Click="BtnDelete_Click" />
        </Grid>

        <!-- 底部按钮（先 Dock 到底部，位于状态栏上方） -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <atom:Button Content="关闭" Click="BtnClose_Click" />
        </StackPanel>

        <!-- 状态栏（Dock 到最底，位于按钮下方） -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,8,0,0" Opacity="0.7" Foreground="{DynamicResource AppTextSecondaryBrush}" />

        <!-- 连接列表（Fill：填满工具栏与底部之间的剩余空间，避免下边错位） -->
        <Border Classes="surface" Margin="0,0,0,14" Padding="6">
            <ListBox x:Name="ConnectionList" ItemsSource="{Binding Connections}"
                     SelectedItem="{Binding SelectedConnection}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionItem">
                        <Border Padding="10,8" Margin="2" CornerRadius="6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6B7C93" />
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
