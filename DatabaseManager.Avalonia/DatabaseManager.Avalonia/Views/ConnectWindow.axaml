<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        x:Class="DatabaseManager.Avalonia.Views.ConnectWindow"
        x:DataType="vm:ConnectionManagerViewModel"
        Title="连接配置"
        Width="600" SizeToContent="Height" MaxHeight="760"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Border Margin="0" Classes="surface" Padding="0">
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">

        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="2">
                <TextBlock Text="新建数据库连接" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="填写连接参数；可点击「测试连接」先验证参数是否正确" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 底部按钮区 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppSubtleBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="TxtTestResult" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <atom:Button Grid.Column="1" Content="取消" Margin="0,0,8,0"
                             Click="BtnCancel_Click" />
                <atom:Button Grid.Column="2" Content="确定" ButtonType="Primary"
                             Click="BtnConfirm_Click" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16">
        <StackPanel Spacing="14" MaxWidth="640">

            <StackPanel Spacing="6">
                <TextBlock Text="数据库类型" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                <atom:ComboBox x:Name="ComboDatabaseType"
                               HorizontalAlignment="Stretch"
                               SelectionChanged="ComboDatabaseType_SelectionChanged" />
            </StackPanel>

            <StackPanel x:Name="PanelKingbaseMode" Spacing="6" IsVisible="False">
                <TextBlock Text="KingbaseES 兼容模式" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                <atom:ComboBox x:Name="ComboKingbaseMode" HorizontalAlignment="Stretch" />
                <TextBlock Text="当前仅验证 PG 兼容模式；Auto 将按 PG 路径尝试连接。" FontSize="11" Foreground="#6B7C93" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="连接名称" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                <atom:TextBox x:Name="TxtProfileName" PlaceholderText="连接名称（Profile Name）" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,7,0">
                    <TextBlock Text="服务器" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <atom:TextBox x:Name="TxtServer" PlaceholderText="服务器地址" />
                </StackPanel>
                <StackPanel Spacing="6" Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="端口" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <atom:TextBox x:Name="TxtPort" PlaceholderText="默认端口" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="认证方式" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                <atom:ComboBox x:Name="ComboAuthentication" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="TxtWindowsAuthenticationHint" IsVisible="False"
                           Text="Windows 身份验证使用当前运行程序的 Windows 账号。"
                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,7,0">
                    <TextBlock Text="用户名" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <atom:TextBox x:Name="TxtUserId" PlaceholderText="用户名" />
                </StackPanel>
                <StackPanel Spacing="6" Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="密码" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <atom:TextBox x:Name="TxtPassword" PlaceholderText="密码" PasswordChar="*" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <atom:CheckBox x:Name="ChkRememberPassword" Content="记住密码" IsChecked="True" />
                <atom:CheckBox x:Name="ChkIsDba" Content="DBA" />
                <atom:CheckBox x:Name="ChkUseSsl" Content="使用 SSL" />
            </StackPanel>
            <Expander Header="SSH 隧道" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <CheckBox x:Name="ChkSsh" Content="启用 SSH 隧道" />
                    <TextBox x:Name="TxtSshHost" PlaceholderText="SSH 主机" />
                    <TextBox x:Name="TxtSshPort" Text="22" PlaceholderText="SSH 端口" />
                    <TextBox x:Name="TxtSshUser" PlaceholderText="SSH 用户名" />
                    <TextBox x:Name="TxtSshKey" PlaceholderText="私钥文件路径（留空使用密码认证）" />
                    <TextBox x:Name="TxtSshSecret" PasswordChar="*" PlaceholderText="SSH 密码或私钥口令（随“记住密码”保存）" />
                    <TextBox x:Name="TxtSshFingerprint" PlaceholderText="经可信渠道核对的 SHA256: 主机指纹" />
                    <TextBlock Text="数据库服务器填写 SSH 主机可访问的地址，并显式填写数据库端口。断线后下次操作重新建立隧道，失败 SQL 不自动重放。" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Grid ColumnDefinitions="*,200">
                <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,7,0">
                    <TextBlock Text="分组" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <atom:TextBox x:Name="TxtGroup" PlaceholderText="分组名（留空则不分组，如：生产环境）" />
                </StackPanel>
                <StackPanel Spacing="6" Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="颜色标签" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                    <ComboBox x:Name="ComboColorTag" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="{Binding}" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="数据库" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <atom:ComboBox x:Name="ComboDatabase" Grid.Column="0" Margin="0,0,8,0"
                                   HorizontalAlignment="Stretch" IsEditable="True" />
                    <atom:Button x:Name="BtnLoadDatabases" Grid.Column="1" Content="加载数据库" Margin="0,0,8,0"
                                 Click="BtnLoadDatabases_Click" />
                    <atom:Button x:Name="BtnTestConnection" Grid.Column="2" Content="测试连接"
                                 Click="BtnTestConnection_Click" />
                </Grid>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</Window>
