<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        x:Class="DatabaseManager.Avalonia.Views.ConnectWindow"
        x:DataType="vm:ConnectionManagerViewModel"
        Title="连接配置"
        Width="560" Height="680"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Border Margin="20" Classes="surface" Padding="24">
    <StackPanel Spacing="16">

        <StackPanel Spacing="2">
            <TextBlock Text="新建数据库连接" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="填写连接信息并测试可用性。" FontSize="12" Foreground="#6B7C93" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="数据库类型" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <atom:ComboBox x:Name="ComboDatabaseType"
                           HorizontalAlignment="Stretch"
                           SelectionChanged="ComboDatabaseType_SelectionChanged" />
        </StackPanel>

        <StackPanel x:Name="PanelKingbaseMode" Spacing="6" IsVisible="False">
            <TextBlock Text="KingbaseES 兼容模式" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <atom:ComboBox x:Name="ComboKingbaseMode" HorizontalAlignment="Stretch" />
            <TextBlock Text="当前仅验证 PG 兼容模式；Auto 将按 PG 路径尝试连接。" FontSize="11" Foreground="#6B7C93" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="连接名称" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <atom:TextBox x:Name="TxtProfileName" PlaceholderText="连接名称（Profile Name）" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="服务器" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <atom:TextBox x:Name="TxtServer" PlaceholderText="服务器地址" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="端口" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:TextBox x:Name="TxtPort" PlaceholderText="端口（留空则使用默认）" />
            </StackPanel>
            <StackPanel Spacing="6" Grid.Column="1" Width="250">
                <TextBlock Text="认证方式" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:ComboBox x:Name="ComboAuthentication" HorizontalAlignment="Stretch">
                    <ComboBoxItem>Password</ComboBoxItem>
                    <ComboBoxItem>Integrated Security</ComboBoxItem>
                </atom:ComboBox>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="用户名" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:TextBox x:Name="TxtUserId" PlaceholderText="用户名" />
            </StackPanel>
            <StackPanel Spacing="6" Grid.Column="1">
                <TextBlock Text="密码" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:TextBox x:Name="TxtPassword" PlaceholderText="密码" PasswordChar="*" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <atom:CheckBox x:Name="ChkRememberPassword" Content="记住密码" IsChecked="True" />
            <atom:CheckBox x:Name="ChkIsDba" Content="DBA" />
            <atom:CheckBox x:Name="ChkUseSsl" Content="使用 SSL" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="分组" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <atom:TextBox x:Name="TxtGroup" PlaceholderText="分组名（留空则不分组，如：生产环境）" />
            </StackPanel>
            <StackPanel Spacing="6" Grid.Column="1" Width="180">
                <TextBlock Text="颜色标签" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <ComboBox x:Name="ComboColorTag" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock Text="数据库" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
                <atom:ComboBox x:Name="ComboDatabase" Grid.Column="0" Margin="0,0,8,0"
                               HorizontalAlignment="Stretch" IsEditable="True" />
                <atom:Button x:Name="BtnLoadDatabases" Grid.Column="1" Content="加载数据库" Margin="0,0,8,0"
                             Click="BtnLoadDatabases_Click" />
                <atom:Button x:Name="BtnTestConnection" Grid.Column="2" Content="测试连接"
                             Click="BtnTestConnection_Click" />
            </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <atom:Button Grid.Column="1" Content="取消" Margin="0,0,8,0"
                         Click="BtnCancel_Click" />
            <atom:Button Grid.Column="2" Content="确定" ButtonType="Primary"
                         Click="BtnConfirm_Click" />
        </Grid>

    </StackPanel>
    </Border>
</Window>
