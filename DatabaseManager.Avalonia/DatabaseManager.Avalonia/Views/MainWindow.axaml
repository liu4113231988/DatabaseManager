<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="using:AtomUI.Controls"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        xmlns:conv="using:DatabaseManager.Avalonia.Converters"
        xmlns:ctrl="using:DatabaseManager.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="DatabaseManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/_dbManager.ico"
        Title="DatabaseManager"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">

    <DockPanel>

        <DockPanel.Resources>
            <conv:NodeIconConverter x:Key="NodeIconConverter" />
        </DockPanel.Resources>

        <!-- 菜单栏（窗口已有系统标题栏，此处不再添加自定义标题栏，避免重复与重叠） -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="新建查询" Command="{Binding NewQueryCommand}" />
                <MenuItem Header="打开脚本..." Click="MenuOpenScript_Click" />
                <MenuItem Header="保存脚本..." Click="MenuSaveScript_Click" />
                <MenuItem Header="最近脚本" ItemsSource="{Binding RecentScripts}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding}" Click="MenuOpenRecent_Click" Tag="{Binding}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator />
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
                <Separator />
                <MenuItem Header="退出" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="连接">
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
                <Separator />
                <MenuItem Header="连接" Command="{Binding ConnectCommand}" />
                <MenuItem Header="重连" Command="{Binding ReconnectCommand}" />
                <MenuItem Header="断开" Command="{Binding DisconnectCommand}" />
            </MenuItem>
            <MenuItem Header="数据库">
                <MenuItem Header="自动提交" ToggleType="CheckBox"
                          IsChecked="{Binding QueryEditor.AutoCommit}" />
                <MenuItem Header="开始事务" Command="{Binding QueryEditor.BeginTransactionCommand}" />
                <MenuItem Header="提交" Command="{Binding QueryEditor.CommitTransactionCommand}" />
                <MenuItem Header="回滚" Command="{Binding QueryEditor.RollbackTransactionCommand}" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="刷新" Click="MenuRefresh_Click" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="数据库转换..." Click="MenuConvert_Click" />
                <MenuItem Header="结构对比..." Click="MenuSchemaCompare_Click" />
                <MenuItem Header="数据对比..." Click="MenuDataCompare_Click" />
                <MenuItem Header="数据库诊断..." Click="MenuDiagnose_Click" />
                <MenuItem Header="数据库优化..." Click="MenuOptimize_Click" />
                <MenuItem Header="依赖分析..." Click="MenuDependency_Click" />
                <Separator />
                <MenuItem Header="统计..." Click="MenuStatistic_Click" />
                <MenuItem Header="索引碎片..." Click="MenuIndexFragmentation_Click" />
                <MenuItem Header="数据库备份..." Click="MenuBackup_Click" />
                <MenuItem Header="代码生成..." Click="MenuCodeGenerate_Click" />
                <MenuItem Header="文档生成..." Click="MenuColumnDocumentation_Click" />
                <Separator />
                <MenuItem Header="数据导出..." Click="MenuExport_Click" />
                <MenuItem Header="数据导入..." Click="MenuImport_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- 主工具栏：位于菜单栏下方，按功能分组（对齐 dbeaver 工具栏布局） -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="4">

                <!-- 文件组 -->
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Click="ToolNewQuery_Click" Padding="4,2" ToolTip.Tip="新建查询">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/AddQuery.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuOpenScript_Click" Padding="4,2" ToolTip.Tip="打开脚本">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/OpenFile.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuSaveScript_Click" Padding="4,2" ToolTip.Tip="保存脚本">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Save32.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="2,2" />

                <!-- 连接组 -->
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Command="{Binding ConnectCommand}" Padding="4,2" ToolTip.Tip="连接">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Command="{Binding ReconnectCommand}" Padding="4,2" ToolTip.Tip="重连">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Command="{Binding DisconnectCommand}" Padding="4,2" ToolTip.Tip="断开">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Database16.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="4,2" />
                    <Button Click="MenuNewConnection_Click" Padding="4,2" ToolTip.Tip="新建连接">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuConnectionManager_Click" Padding="4,2" ToolTip.Tip="连接管理">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Edit.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="2,2" />

                <!-- SQL 执行组（绑定到当前选中的查询标签） -->
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Classes="Primary" Click="ToolExecute_Click" Padding="4,2" ToolTip.Tip="执行 (F5)"
                            IsEnabled="{Binding SelectedQueryTab.IsExecuting, Converter={x:Static conv:BoolOppositeConverter.Instance}}">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Run.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="4,2" />
                    <!-- 事务组（绑定到当前标签） -->
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="自动提交" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding QueryEditor.AutoCommit}" />
                        </StackPanel>
                        <Button Classes="Default" Command="{Binding QueryEditor.BeginTransactionCommand}" Padding="4,2" ToolTip.Tip="开始事务">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/DbScripts.png" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button Command="{Binding QueryEditor.CommitTransactionCommand}" Padding="4,2" ToolTip.Tip="提交">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/Save32.png" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button Command="{Binding QueryEditor.RollbackTransactionCommand}" Padding="4,2" ToolTip.Tip="回滚">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/Translate.png" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="2,2" />

                <!-- Schema 选择组（多 Schema 数据库时显示） -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SchemaSelectorVisible}">
                    <TextBlock Text="Schema:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding CurrentSchema}" Width="120"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Border Width="1" Background="#22000000" VerticalAlignment="Stretch" Margin="2,2" />

                <!-- 工具组 -->
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Click="MenuDataCompare_Click" Padding="4,2" ToolTip.Tip="数据对比">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DataCompare32.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuSchemaCompare_Click" Padding="4,2" ToolTip.Tip="结构对比">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Compare32.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuConvert_Click" Padding="4,2" ToolTip.Tip="数据库转换">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConvert.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuDiagnose_Click" Padding="4,2" ToolTip.Tip="诊断">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Tool16.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="MenuBackup_Click" Padding="4,2" ToolTip.Tip="备份">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbBackup.png" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="#1A000000">
            <TextBlock Text="{Binding ConnectionSummary}" VerticalAlignment="Center" Margin="12,0" />
        </Border>

        <!-- 主内容：左对象浏览器 / 右查询内容区（两栏分离，避免重叠） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：对象浏览器（连接列表 + 对象树） -->
            <Border Grid.Column="0"
                    BorderBrush="#22000000" BorderThickness="0,0,1,0" Margin="0,0,0,4">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="对象浏览器" FontWeight="Bold" Margin="2,2,2,4" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 对象树：所有连接平铺展示（dbeaver 风格），双击或右键连接 -->
                        <TreeView Grid.Row="1"
                                  x:Name="ObjectsTree"
                                  ItemsSource="{Binding ObjectsExplorer.RootNodes}"
                                  DoubleTapped="ObjectsTree_DoubleTapped"
                                  ContextRequested="ObjectsTree_ContextRequested"
                                  BorderThickness="0"
                                  Padding="0"
                                  Margin="2,0,0,0"
                                  FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                                  FontSize="12">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="Padding" Value="0,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="18" />
                                </Style>
                                <!-- 减少子级缩进量 -->
                                <Style Selector="TreeViewItem /template/ Border#PART_IndentContainer">
                                    <Setter Property="Margin" Value="-10,0,0,0" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:DbObjectTreeNode"
                                                  ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="1"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center">
                                        <Image Source="{Binding Converter={StaticResource NodeIconConverter}}"
                                               Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="280" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右：主内容区（对齐 DBeaver：多查询标签 + 查询/数据编辑子选项卡） -->
            <DockPanel Grid.Column="1" Margin="4,0,4,4">

                <!-- 顶部：多查询标签栏（对齐 DBeaver 标签页设计） -->
                <TabControl DockPanel.Dock="Top"
                            x:Name="QueryTabsControl"
                            ItemsSource="{Binding QueryTabs}"
                            SelectedItem="{Binding SelectedQueryTab}"
                            TabStripPlacement="Top">
                    <TabControl.DataTemplates>
                        <!-- 查询标签页模板 -->
                        <DataTemplate DataType="vm:QueryTabViewModel">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 状态栏 / 编辑器 / 分割条 / 结果区；编辑器与结果区按 2:1 分配，可拖动分割条调整 -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2*" MinHeight="100" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                </Grid.RowDefinitions>

                                <!-- SQL 状态栏 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,2">
                                    <TextBlock Text="SQL：" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding ConnectionName}"
                                               VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                                </StackPanel>

                                <!-- SQL 编辑器（带语法高亮） -->
                                <ctrl:SqlEditor Grid.Row="1"
                                                SqlText="{Binding SqlText, Mode=TwoWay}" />

                                <!-- 上下分割条（拖动调整编辑器/结果区高度比例） -->
                                <GridSplitter Grid.Row="2"
                                              HorizontalAlignment="Stretch"
                                              Height="5" Margin="0,1"
                                              ResizeDirection="Rows"
                                              ResizeBehavior="PreviousAndNext"
                                              Background="#E0E0E0" />

                                <!-- 结果区 -->
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                                               Margin="4,2,0,2" Opacity="0.7" FontSize="11" />
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                                              IsVisible="{Binding HasResult}"
                                              AutoGenerateColumns="False"
                                              GridLinesVisibility="All"
                                              FontSize="11"
                                              Margin="2" x:Name="QueryResultGrid">
                                        <DataGrid.Columns>
                                            <!-- 列由代码动态生成 -->
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" Text="（无结果）"
                                               IsVisible="{Binding ShowNoResult}"
                                               Opacity="0.4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="20" />

                                    <!-- 分页栏（大数据量分页显示） -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                                                Margin="4,2,4,4"
                                                IsVisible="{Binding HasResult}">
                                        <Button Command="{Binding FirstPageCommand}" Content="首页"
                                                Padding="8,1" FontSize="11" MinWidth="0" />
                                        <Button Command="{Binding PrevPageCommand}" Content="上一页"
                                                Padding="8,1" FontSize="11" MinWidth="0" />
                                        <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"
                                                   FontSize="11" Opacity="0.8" />
                                        <Button Command="{Binding NextPageCommand}" Content="下一页"
                                                Padding="8,1" FontSize="11" MinWidth="0" />
                                        <Button Command="{Binding LastPageCommand}" Content="末页"
                                                Padding="8,1" FontSize="11" MinWidth="0" />
                                        <TextBlock Text="每页" VerticalAlignment="Center" FontSize="11"
                                                   Opacity="0.6" Margin="8,0,0,0" />
                                        <ComboBox SelectedItem="{Binding PageSize}"
                                                  ItemsSource="{Binding PageSizeOptions}"
                                                  FontSize="11" MinWidth="70" />
                                        <TextBlock Text="行" VerticalAlignment="Center" FontSize="11"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TabControl.DataTemplates>

                    <!-- 标签头模板（带关闭按钮，右键菜单通过 ContextRequested 事件处理） -->
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="vm:QueryTabViewModel">
                            <Border x:Name="TabHeaderBorder" 
                                   Padding="4,2" 
                                   Background="Transparent"
                                   ContextRequested="TabHeader_ContextRequested"
                                   Tag="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="11" />
                                    <Button Click="CloseTab_Click" Tag="{Binding}"
                                            Width="16" Height="16" Padding="0"
                                            Margin="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="关闭标签">
                                        <TextBlock Text="×" FontSize="10" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Foreground="#666" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

            </DockPanel>
        </Grid>
    </DockPanel>

</Window>
