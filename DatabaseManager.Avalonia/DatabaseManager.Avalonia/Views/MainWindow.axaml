<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="using:AtomUI.Controls"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="DatabaseManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DatabaseManager (Avalonia)"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- 菜单栏（窗口已有系统标题栏，此处不再添加自定义标题栏，避免重复与重叠） -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
                <Separator />
                <MenuItem Header="退出" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="连接">
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="刷新" Click="MenuRefresh_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,8">
            <atom:Button Content="新建连接" ButtonType="Primary" Click="MenuNewConnection_Click" />
            <atom:Button Content="连接管理" Click="MenuConnectionManager_Click" />
        </StackPanel>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="#1A000000">
            <TextBlock Text="{Binding ConnectionSummary}" VerticalAlignment="Center" Margin="12,0" />
        </Border>

        <!-- 主内容三栏：左对象树 / 中内容区 / 下结果区 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <!-- 左：对象浏览器（连接列表 + 对象树） -->
            <Border Grid.Row="0" Width="300" HorizontalAlignment="Left"
                    BorderBrush="#22000000" BorderThickness="0,0,1,0" Margin="0,0,0,4">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="对象浏览器" FontWeight="Bold" Margin="4,4,4,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SupportedDatabases}"
                               FontSize="11" Opacity="0.6" Margin="4,0,4,8" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 连接下拉 -->
                        <ComboBox Grid.Row="0"
                                  ItemsSource="{Binding Connections}"
                                  SelectedItem="{Binding SelectedConnection}"
                                  DisplayMemberBinding="{Binding Name}"
                                  Margin="0,0,0,6" />

                        <!-- 对象树 -->
                        <TreeView Grid.Row="1"
                                  x:Name="ObjectsTree"
                                  ItemsSource="{Binding ObjectsExplorer.RootNodes}"
                                  DoubleTapped="ObjectsTree_DoubleTapped"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:DbObjectTreeNode"
                                                  ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Text}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 中：内容区（Tab 容器：欢迎页 / 查询编辑器） -->
            <Grid Grid.Row="0" Margin="8,0,8,4">
                <TabControl>
                    <TabItem Header="欢迎">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="DatabaseManager (Avalonia)"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SupportedDatabases}"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.7" />
                            <TextBlock Text="在左侧选择连接并展开对象树，或切换到「查询」页执行 SQL。"
                                       HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </TabItem>

                    <!-- 查询编辑器 -->
                    <TabItem Header="查询">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- SQL 输入 -->
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4">
                                    <TextBlock Text="SQL：" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding QueryEditor.ConnectionName}"
                                               VerticalAlignment="Center" Opacity="0.6" />
                                    <atom:Button Content="执行" ButtonType="Primary"
                                                 Command="{Binding QueryEditor.ExecuteCommand}" />
                                </StackPanel>
                                <TextBox Grid.Row="1"
                                         Text="{Binding QueryEditor.SqlText}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas, monospace"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         Margin="4" />
                            </Grid>

                            <GridSplitter Grid.Row="1" Height="4" Background="#22000000" />

                            <!-- 查询结果 -->
                            <Grid Grid.Row="2" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding QueryEditor.StatusMessage}"
                                               Margin="2,0,0,4" Opacity="0.8" />
                                    <DataGrid x:Name="QueryResultGrid"
                                              IsVisible="{Binding QueryEditor.HasResult}"
                                              ItemsSource="{Binding QueryEditor.Rows}"
                                              AutoGenerateColumns="False"
                                              GridLinesVisibility="All" />
                                    <TextBlock Text="（无结果）" IsVisible="{Binding QueryEditor.ShowNoResult}"
                                               Opacity="0.5" Margin="4" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Row="1" Height="4" Background="#22000000" />

            <!-- 下：结果区 -->
            <Border Grid.Row="2" Margin="8,4,8,8" BorderBrush="#22000000" BorderThickness="1">
                <TextBlock Text="结果区" VerticalAlignment="Top" Margin="8" Opacity="0.7" />
            </Border>
        </Grid>
    </DockPanel>

</Window>
