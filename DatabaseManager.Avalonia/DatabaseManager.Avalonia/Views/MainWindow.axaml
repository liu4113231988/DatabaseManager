<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="using:AtomUI.Controls"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        xmlns:conv="using:DatabaseManager.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="DatabaseManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/_dbManager.ico"
        Title="DatabaseManager (Avalonia)"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <DockPanel.Resources>
            <conv:NodeIconConverter x:Key="NodeIconConverter" />
        </DockPanel.Resources>

        <!-- 菜单栏（窗口已有系统标题栏，此处不再添加自定义标题栏，避免重复与重叠） -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="新建查询" Command="{Binding NewQueryCommand}" />
                <MenuItem Header="打开脚本..." Click="MenuOpenScript_Click" />
                <MenuItem Header="保存脚本..." Click="MenuSaveScript_Click" />
                <MenuItem Header="最近脚本" ItemsSource="{Binding RecentScripts}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding}" Click="MenuOpenRecent_Click" Tag="{Binding}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator />
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
                <Separator />
                <MenuItem Header="退出" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="连接">
                <MenuItem Header="新建连接" Click="MenuNewConnection_Click" />
                <MenuItem Header="连接管理" Click="MenuConnectionManager_Click" />
                <Separator />
                <MenuItem Header="连接" Command="{Binding ConnectCommand}" />
                <MenuItem Header="重连" Command="{Binding ReconnectCommand}" />
                <MenuItem Header="断开" Command="{Binding DisconnectCommand}" />
            </MenuItem>
            <MenuItem Header="数据库">
                <MenuItem Header="自动提交" ToggleType="CheckBox"
                          IsChecked="{Binding QueryEditor.AutoCommit}" />
                <MenuItem Header="开始事务" Command="{Binding QueryEditor.BeginTransactionCommand}" />
                <MenuItem Header="提交" Command="{Binding QueryEditor.CommitTransactionCommand}" />
                <MenuItem Header="回滚" Command="{Binding QueryEditor.RollbackTransactionCommand}" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="刷新" Click="MenuRefresh_Click" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="数据库转换..." Click="MenuConvert_Click" />
                <MenuItem Header="结构对比..." Click="MenuSchemaCompare_Click" />
                <MenuItem Header="数据对比..." Click="MenuDataCompare_Click" />
                <MenuItem Header="数据库诊断..." Click="MenuDiagnose_Click" />
                <MenuItem Header="数据库优化..." Click="MenuOptimize_Click" />
                <MenuItem Header="依赖分析..." Click="MenuDependency_Click" />
                <Separator />
                <MenuItem Header="统计..." Click="MenuStatistic_Click" />
                <MenuItem Header="索引碎片..." Click="MenuIndexFragmentation_Click" />
                <MenuItem Header="数据库备份..." Click="MenuBackup_Click" />
                <MenuItem Header="代码生成..." Click="MenuCodeGenerate_Click" />
                <MenuItem Header="文档生成..." Click="MenuColumnDocumentation_Click" />
                <Separator />
                <MenuItem Header="数据导出..." Click="MenuExport_Click" />
                <MenuItem Header="数据导入..." Click="MenuImport_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- 主工具栏：位于菜单栏下方，按功能分组（对齐 dbeaver 工具栏布局） -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="12">

                <!-- 文件组 -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <atom:Button Click="ToolNewQuery_Click" Padding="6,2" ToolTip.Tip="新建查询">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/AddQuery.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuOpenScript_Click" Padding="6,2" ToolTip.Tip="打开脚本">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/OpenFile.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuSaveScript_Click" Padding="6,2" ToolTip.Tip="保存脚本">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Save32.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                </StackPanel>

                <Separator />

                <!-- 连接组 -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <atom:Button Command="{Binding ConnectCommand}" Padding="6,2" ToolTip.Tip="连接">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Command="{Binding ReconnectCommand}" Padding="6,2" ToolTip.Tip="重连">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Command="{Binding DisconnectCommand}" Padding="6,2" ToolTip.Tip="断开">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Database16.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <Separator Margin="6,0" />
                    <atom:Button Click="MenuNewConnection_Click" Padding="6,2" ToolTip.Tip="新建连接">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConnect16.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuConnectionManager_Click" Padding="6,2" ToolTip.Tip="连接管理">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Edit.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                </StackPanel>

                <Separator />

                <!-- SQL 执行组 -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <atom:Button ButtonType="Primary" Command="{Binding QueryEditor.ExecuteCommand}" Padding="6,2" ToolTip.Tip="执行">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Run.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <Separator Margin="6,0" />
                    <!-- 事务组 -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="自动提交" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding QueryEditor.AutoCommit}" />
                        </StackPanel>
                        <atom:Button ButtonType="Default" Command="{Binding QueryEditor.BeginTransactionCommand}" Padding="6,2" ToolTip.Tip="开始事务">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/DbScripts.png" Width="16" Height="16" Stretch="Uniform" />
                        </atom:Button>
                        <atom:Button Command="{Binding QueryEditor.CommitTransactionCommand}" Padding="6,2" ToolTip.Tip="提交">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/Save32.png" Width="16" Height="16" Stretch="Uniform" />
                        </atom:Button>
                        <atom:Button Command="{Binding QueryEditor.RollbackTransactionCommand}" Padding="6,2" ToolTip.Tip="回滚">
                            <Image Source="avares://DatabaseManager.Avalonia/Assets/Translate.png" Width="16" Height="16" Stretch="Uniform" />
                        </atom:Button>
                    </StackPanel>
                </StackPanel>

                <Separator />

                <!-- Schema 选择组（多 Schema 数据库时显示） -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SchemaSelectorVisible}">
                    <TextBlock Text="Schema:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding CurrentSchema}" Width="120"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Separator />

                <!-- 工具组 -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <atom:Button Click="MenuDataCompare_Click" Padding="6,2" ToolTip.Tip="数据对比">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DataCompare32.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuSchemaCompare_Click" Padding="6,2" ToolTip.Tip="结构对比">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Compare32.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuConvert_Click" Padding="6,2" ToolTip.Tip="数据库转换">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbConvert.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuDiagnose_Click" Padding="6,2" ToolTip.Tip="诊断">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/Tool16.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                    <atom:Button Click="MenuBackup_Click" Padding="6,2" ToolTip.Tip="备份">
                        <Image Source="avares://DatabaseManager.Avalonia/Assets/DbBackup.png" Width="16" Height="16" Stretch="Uniform" />
                    </atom:Button>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="#1A000000">
            <TextBlock Text="{Binding ConnectionSummary}" VerticalAlignment="Center" Margin="12,0" />
        </Border>

        <!-- 主内容：左对象浏览器 / 右查询内容区（两栏分离，避免重叠） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：对象浏览器（连接列表 + 对象树） -->
            <Border Grid.Column="0"
                    BorderBrush="#22000000" BorderThickness="0,0,1,0" Margin="0,0,0,4">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="对象浏览器" FontWeight="Bold" Margin="4,4,4,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SupportedDatabases}"
                               FontSize="11" Opacity="0.6" Margin="4,0,4,8" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 对象树：所有连接平铺展示（dbeaver 风格），双击或右键连接 -->
                        <TreeView Grid.Row="1"
                                  x:Name="ObjectsTree"
                                  ItemsSource="{Binding ObjectsExplorer.RootNodes}"
                                  DoubleTapped="ObjectsTree_DoubleTapped"
                                  ContextRequested="ObjectsTree_ContextRequested"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:DbObjectTreeNode"
                                                  ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Tag="{Binding}">
                                        <Image Source="{Binding Converter={StaticResource NodeIconConverter}}"
                                               Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右：查询 / 数据编辑 多标签区 -->
            <TabControl Grid.Column="1" Margin="8,0,8,4" x:Name="ContentTabs">

                <!-- 查询编辑器标签 -->
                <TabItem Header="查询">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- SQL 输入 -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4">
                                <TextBlock Text="SQL：" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding QueryEditor.ConnectionName}"
                                           VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Text="{Binding QueryEditor.StatusMessage}"
                                           VerticalAlignment="Center" Opacity="0.8" />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Text="{Binding QueryEditor.SqlText}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas, monospace"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     Margin="4" />
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="4" Background="#22000000" />

                        <!-- 查询结果 -->
                        <Grid Grid.Row="2" Margin="4">
                            <StackPanel>
                                <TextBlock Text="{Binding QueryEditor.StatusMessage}"
                                           Margin="2,0,0,4" Opacity="0.8" />
                                <DataGrid x:Name="QueryResultGrid"
                                          IsVisible="{Binding QueryEditor.HasResult}"
                                          ItemsSource="{Binding QueryEditor.Rows}"
                                          AutoGenerateColumns="False"
                                          GridLinesVisibility="All" />
                                <TextBlock Text="（无结果）" IsVisible="{Binding QueryEditor.ShowNoResult}"
                                           Opacity="0.5" Margin="4" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 数据编辑器标签 -->
                <TabItem Header="数据编辑" IsEnabled="{Binding DataEditor.IsLoaded}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="4">
                            <TextBlock Text="{Binding DataEditor.TableName}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataEditor.DatabaseName}" Opacity="0.6"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataEditor.StatusMessage}" Opacity="0.8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Separator Margin="4,0" />
                            <atom:Button Content="＋ 新增" Command="{Binding DataEditor.AddRowCommand}"
                                         IsEnabled="{Binding DataEditor.IsEditable}" />
                            <atom:Button Content="－ 删除" Click="DataEditorRemove_Click" />
                            <Separator Margin="4,0" />
                            <atom:Button Content="↺ 还原" Command="{Binding DataEditor.RevertCommand}" />
                            <atom:Button Content="✓ 保存" ButtonType="Primary"
                                         Command="{Binding DataEditor.SaveCommand}"
                                         IsEnabled="{Binding DataEditor.HasChanges}" />
                            <Separator Margin="4,0" />
                            <!-- 分页 -->
                            <TextBlock Text="第" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataEditor.PageNumber}" VerticalAlignment="Center" />
                            <TextBlock Text="/" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataEditor.PageCount}" VerticalAlignment="Center" />
                            <TextBlock Text="页" VerticalAlignment="Center" />
                            <atom:Button Content="上一页" Command="{Binding DataEditor.PreviousPageCommand}" />
                            <atom:Button Content="下一页" Command="{Binding DataEditor.NextPageCommand}" />
                        </StackPanel>

                        <!-- 数据网格（可编辑） -->
                        <DataGrid Grid.Row="1" x:Name="DataEditGrid"
                                  ItemsSource="{Binding DataEditor.Rows}"
                                  AutoGenerateColumns="False"
                                  GridLinesVisibility="All"
                                  SelectionMode="Extended"
                                  IsReadOnly="{Binding DataEditor.IsView}"
                                  Margin="4" />

                        <TextBlock Grid.Row="2" Text="提示：视图为只读；自增/计算/二进制列不可编辑。"
                                   Opacity="0.5" Margin="4" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

</Window>
