<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.OptimizeWindow"
        x:DataType="vm:OptimizeViewModel"
        Title="数据库优化"
        Width="920" Height="620"
        Icon="/Assets/_dbManager.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- 顶部：连接与操作 -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Text="数据库" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboConnection" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button Content="开始优化" ButtonType="Primary" Command="{Binding ExecuteCommand}"
                             IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="刷新连接" Click="BtnRefresh_Click" />
                <atom:Button Content="关闭" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,6,0,0" Opacity="0.75" TextWrapping="Wrap" />

        <!-- 中部：结果 + 日志 -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="优化结果">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="优化对象（对象类型 / 数据长度变化）" FontWeight="Bold" Margin="2,0,0,4" />
                    <Border BorderBrush="#22000000" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="对象类型" Binding="{Binding ObjectType}" Width="1*" />
                                <DataGridTextColumn Header="对象名" Binding="{Binding ObjectName}" Width="1.6*" />
                                <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="0.7*" />
                                <DataGridTextColumn Header="数据长度 (前 → 后)" Binding="{Binding DataLengthText}" Width="1.4*" />
                                <DataGridTextColumn Header="错误信息" Binding="{Binding Message}" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="日志">
                <Border BorderBrush="#22000000" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Logs}" IsHitTestVisible="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
