<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        x:Class="DatabaseManager.Avalonia.Views.FloatingResultWindow"
        x:DataType="vm:QueryTabViewModel"
        Title="查询结果（浮动）"
        Width="720" Height="480"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="8" RowDefinitions="Auto,*,Auto">

        <!-- 状态栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.75" FontSize="11"
                       TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Text="{Binding FilterSummary}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
            <Button Classes="compact" Content="⇲ 停靠回主窗口" Click="DockBack_Click" HorizontalAlignment="Right"
                    ToolTip.Tip="关闭浮动窗口并把结果区恢复到主窗口" />
        </StackPanel>

        <!-- 结果网格（与主窗口共享同一查询标签的行/列，实时同步） -->
        <DataGrid Grid.Row="1" x:Name="FloatingGrid" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" GridLinesVisibility="All" CanUserResizeColumns="True"
                  CanUserSortColumns="False" FontSize="11"
                  AttachedToVisualTree="FloatingGrid_AttachedToVisualTree" />

        <!-- 分页 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                    IsVisible="{Binding HasResult}">
            <Button Classes="compact" Command="{Binding FirstPageCommand}" Content="首页" />
            <Button Classes="compact" Command="{Binding PrevPageCommand}" Content="上一页" />
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" FontSize="11" Opacity="0.8" />
            <Button Classes="compact" Command="{Binding NextPageCommand}" Content="下一页" />
            <Button Classes="compact" Command="{Binding LastPageCommand}" Content="末页" />
        </StackPanel>
    </Grid>
</Window>
