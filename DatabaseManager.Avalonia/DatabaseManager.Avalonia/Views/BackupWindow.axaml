<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        x:Class="DatabaseManager.Avalonia.Views.BackupWindow"
        x:DataType="vm:BackupViewModel"
        Title="数据库备份与恢复"
        Width="920" Height="600"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <!-- VS/SSMS 风格布局：标题区 + 内容区 + 蓝条状态条 -->
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">
        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" Text="数据库备份与恢复" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="创建数据库备份文件或从已有备份恢复；恢复将修改目标数据库" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <TextBlock Text="数据库备份与恢复" Foreground="{DynamicResource AppStatusBarTextBrush}"
                       FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- 内容区 -->
        <DockPanel Margin="16">


        <!-- 顶部：连接与配置 -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="120,*">
                <TextBlock Grid.Column="0" Text="数据库" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboConnection" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnDefinitions="120,*,Auto">
                <TextBlock Grid.Column="0" Text="保存文件夹" VerticalAlignment="Center" />
                <atom:TextBox Grid.Column="1" Text="{Binding SaveFolder}" PlaceholderText="备份文件保存目录（默认 Backup）"
                              HorizontalAlignment="Stretch" />
                <atom:Button Grid.Column="2" Content="..." Margin="6,0,0,0" Click="BtnBrowseFolder_Click" />
            </Grid>

            <Grid ColumnDefinitions="120,*,Auto">
                <TextBlock Grid.Column="0" Text="恢复文件" VerticalAlignment="Center" />
                <atom:TextBox x:Name="RestoreFileBox" Grid.Column="1" Text="{Binding RestoreFilePath}" PlaceholderText="选择要恢复的备份文件"
                              HorizontalAlignment="Stretch" />
                <atom:Button Grid.Column="2" Content="..." Margin="6,0,0,0" Click="BtnBrowseRestoreFile_Click" />
            </Grid>

            <Grid ColumnDefinitions="120,*,Auto">
                <TextBlock Grid.Column="0" Text="客户端工具" VerticalAlignment="Center" />
                <atom:TextBox Grid.Column="1" Text="{Binding ClientToolFilePath}"
                    PlaceholderText="备份：mysqldump / pg_dump / exp；恢复：mysql / psql 或 pg_restore / imp（SQL Server 无需）"
                              HorizontalAlignment="Stretch" />
                <atom:Button Grid.Column="2" Content="..." Margin="6,0,0,0" Click="BtnBrowseTool_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:CheckBox Content="压缩备份文件 (ZIP)" IsChecked="{Binding ZipFile}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button x:Name="BackupButton" Content="开始备份" ButtonType="Primary" Command="{Binding BackupCommand}"
                             IsEnabled="{Binding CanBackup}" />
                <atom:Button x:Name="RestoreButton" Content="恢复备份" Click="BtnRestore_Click" IsEnabled="{Binding CanRestore}" />
                <atom:Button Content="刷新连接" Click="BtnRefresh_Click" IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="关闭" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,6,0,0" Opacity="0.75" TextWrapping="Wrap" />

        <!-- 中部：日志 -->
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
            <ListBox ItemsSource="{Binding Logs}" IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </DockPanel>
    </DockPanel>

</Window>
