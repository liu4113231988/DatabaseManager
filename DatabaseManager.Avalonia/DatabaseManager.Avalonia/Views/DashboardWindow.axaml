<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:DatabaseManager.Avalonia.Controls"
        xmlns:self="using:DatabaseManager.Avalonia.Views"
        x:Class="DatabaseManager.Avalonia.Views.DashboardWindow"
        Title="仪表盘"
        Width="960" Height="680"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Text="仪表盘：已保存的图表（数据按定义重新执行 SQL 获取）"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
            <Button Grid.Column="1" x:Name="BtnRefresh" Content="全部刷新" Click="BtnRefresh_Click" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="关闭" Click="BtnClose_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="self:DashboardCard">
                        <Border Width="450" Height="280" Margin="0,0,10,10" CornerRadius="6"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource AppSurfaceBrush}">
                            <Grid Margin="10" RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="10" Opacity="0.55"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ctrl:ChartRenderControl Grid.Row="1" Chart="{Binding Model}" Margin="0,4" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="compact" Content="打开" Click="CardOpen_Click" Tag="{Binding}"
                                            ToolTip.Tip="在图表窗口打开（可编辑配置）" />
                                    <Button Classes="compact" Content="刷新" Click="CardRefresh_Click" Tag="{Binding}" />
                                    <Button Classes="compact" Content="删除" Click="CardDelete_Click" Tag="{Binding}" />
                                    <TextBlock Text="{Binding ErrorText}" FontSize="10" Foreground="#D97706"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="200" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="图表在查询结果窗口生成并保存；打开卡片可调整配置或查看明细。"
                   FontSize="10" Opacity="0.5" Margin="0,6,0,0" />
    </Grid>
</Window>
