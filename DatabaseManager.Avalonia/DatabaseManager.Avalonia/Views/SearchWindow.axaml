<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        x:Class="DatabaseManager.Avalonia.Views.SearchWindow"
        x:DataType="vm:SearchViewModel"
        Title="元数据搜索"
        Width="760" Height="520"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <!-- VS/SSMS 风格布局：标题区 + 内容区 + 蓝条状态条 -->
    <DockPanel Background="{DynamicResource AppWindowBgBrush}">
        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel Spacing="2">
                <TextBlock Text="元数据搜索" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="按名称搜索表/视图/列/存储过程等" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <TextBlock Text="元数据搜索" Foreground="{DynamicResource AppStatusBarTextBrush}"
                       FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- 内容区 -->
        <DockPanel Margin="16">


        <!-- 顶部：连接 + 关键字 + 搜索 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="连接" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboConnections" Width="180" MinWidth="180"
                               ItemsSource="{Binding Connections}"
                               SelectedItem="{Binding SelectedConnectionName}" />
            </StackPanel>

            <atom:TextBox Grid.Column="1" x:Name="TxtKeyword" Margin="6,0,0,0"
                     Text="{Binding Keyword}" PlaceholderText="输入表 / 视图 / 列 / 过程 / 函数名称关键字..."
                     KeyDown="TxtKeyword_KeyDown" />

            <atom:Button Grid.Column="2" Content="搜索" ButtonType="Primary" Margin="6,0,0,0"
                         Command="{Binding SearchCommand}" IsEnabled="{Binding CanSearch}" />
        </Grid>

        <!-- 底部：操作按钮 + 状态栏 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
            <atom:Button Content="在树中定位" Click="BtnLocate_Click"
                         IsEnabled="{Binding HasSelected}" />
            <atom:Button Content="生成 SELECT" ButtonType="Primary" Click="BtnGenerateSelect_Click"
                         IsEnabled="{Binding HasSelectedTableOrView}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
        </StackPanel>

        <!-- 结果列表 -->
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
            <DataGrid x:Name="ResultsGrid"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                  DoubleTapped="ResultsGrid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80" />
                    <DataGridTextColumn Header="数据库" Binding="{Binding DatabaseName}" Width="120" />
                    <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="100" />
                    <DataGridTextColumn Header="对象" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="父对象" Binding="{Binding ParentName}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        </DockPanel>
    </DockPanel>

</Window>
