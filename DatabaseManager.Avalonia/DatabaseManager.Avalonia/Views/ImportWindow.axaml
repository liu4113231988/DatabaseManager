<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Title="数据导入"
        Width="860" Height="760"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- 顶部：连接/目标表/文件 -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">

            <!-- 连接 -->
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="连接" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboConnection" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 目标表 -->
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="目标表" VerticalAlignment="Center" />
                <atom:ComboBox x:Name="ComboTable" Grid.Column="1" HorizontalAlignment="Stretch"
                               ItemsSource="{Binding Tables}" />
            </Grid>

            <!-- 文件路径 -->
            <Grid ColumnDefinitions="110,*,Auto">
                <TextBlock Grid.Column="0" Text="导入文件" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding FilePath}" VerticalContentAlignment="Center" />
                <atom:Button Grid.Column="2" Content="浏览..." Margin="8,0,0,0" Click="BtnBrowseFile_Click" />
            </Grid>

            <!-- 选项 -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                    <atom:CheckBox Content="首行为列名" IsChecked="{Binding FirstRowIsColumnName}" />
                    <atom:CheckBox Content="使用列映射" IsChecked="{Binding UseColumnMapping}" x:Name="UseColumnMappingCheckBox" />
                    <atom:CheckBox Content="跳过错误行继续导入" IsChecked="{Binding ContinueOnInvalidRows}"
                                   ToolTip.Tip="校验未通过的错误行不入库，其余行继续导入（结果中给出错误行报告）" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                    <TextBlock Text="编码：" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="ComboEncoding" ItemsSource="{Binding EncodingOptions}" MinWidth="150"
                              SelectedItem="{Binding SelectedEncoding}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="跳过前 N 行：" VerticalAlignment="Center" FontSize="12"
                               ToolTip.Tip="导入失败后可从指定行继续（续导）" />
                    <TextBox Text="{Binding SkipRows}" Width="60" VerticalContentAlignment="Center" FontSize="12" />
                </StackPanel>
            </WrapPanel>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <atom:Button Content="导入" ButtonType="Primary" Command="{Binding ImportCommand}"
                             IsEnabled="{Binding !IsBusy}" />
                <atom:Button Content="取消" Command="{Binding CancelImportCommand}"
                             IsEnabled="{Binding IsBusy}" />
                <atom:Button Content="刷新连接" Click="BtnRefresh_Click" />
                <atom:Button Content="关闭" Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="2,6,0,0" Opacity="0.75" TextWrapping="Wrap" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 文件预览（选择文件后展示列与样例行） -->
            <Border Grid.Row="0" BorderBrush="#22000000" BorderThickness="1"
                    Margin="0,0,0,8" IsVisible="{Binding HasPreview}">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <TextBlock Grid.Row="0" Text="文件预览（前 5 行）" FontWeight="Bold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="1" x:Name="PreviewGrid"
                              ItemsSource="{Binding PreviewRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              CanUserResizeColumns="True" MaxHeight="150" FontSize="11"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <!-- 列映射区（可选） -->
            <Border Grid.Row="1" BorderBrush="#22000000" BorderThickness="1"
                    Margin="0,0,0,8" IsVisible="{Binding UseColumnMapping}">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock Text="列映射（文件列 → 表列）" FontWeight="Bold" VerticalAlignment="Center" />
                        <atom:Button Content="＋ 新增" Command="{Binding AddColumnMappingCommand}" />
                        <atom:Button Content="－ 删除选中" Click="BtnRemoveMapping_Click" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="MappingGrid"
                              ItemsSource="{Binding ColumnMappings}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="All"
                              MinHeight="100" MaxHeight="170"
                              HeadersVisibility="Column"
                              CanUserResizeColumns="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件列" Binding="{Binding SourceColumn}" Width="1*" />
                            <DataGridTextColumn Header="表列" Binding="{Binding TargetColumn}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 错误行报告 -->
            <Border Grid.Row="2" BorderBrush="#22000000" BorderThickness="1"
                    Margin="0,0,0,8" IsVisible="{Binding HasErrors}">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <TextBlock Grid.Row="0" Text="错误行报告" FontWeight="Bold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ErrorRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              CanUserResizeColumns="True" MaxHeight="150" FontSize="11"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="数据行号" Binding="{Binding RowNumber}" Width="90" />
                            <DataGridTextColumn Header="错误描述" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 日志区 -->
            <Border Grid.Row="3" BorderBrush="#22000000" BorderThickness="1">
                <ListBox ItemsSource="{Binding Logs}" IsHitTestVisible="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

    </DockPanel>
</Window>
