<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.TaskCenterWindow"
        x:DataType="vm:TaskCenterViewModel"
        Title="任务中心"
        Width="920" Height="620"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- 顶部操作 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,0,0,8">
            <atom:Button Content="刷新" Command="{Binding RefreshCommand}" />
            <atom:Button Content="取消选中任务" Command="{Binding CancelSelectedCommand}" />
            <atom:Button Content="关闭" Click="BtnClose_Click" />
        </StackPanel>

        <TabControl>
            <!-- 本会话任务 -->
            <TabItem Header="本会话任务">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Runs}"
                              SelectedItem="{Binding SelectedRun}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              CanUserResizeColumns="True" FontSize="11"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="80" />
                            <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAtText}" Width="80" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="70" />
                            <DataGridTextColumn Header="进度/结果" Binding="{Binding ResultSummary}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="6" Background="{DynamicResource AppDividerBrush}" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="任务日志" FontWeight="Bold" Margin="2,0,0,4" />
                        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                            <TextBox Text="{Binding SelectedRunLogs, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 历史记录 -->
            <TabItem Header="历史记录" IsVisible="{Binding HasHistory}">
                <DataGrid Margin="0,8,0,0" ItemsSource="{Binding History}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          CanUserResizeColumns="True" FontSize="11"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90" />
                        <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt, StringFormat='MM-dd HH:mm:ss'}" Width="120" />
                        <DataGridTextColumn Header="结果" Binding="{Binding ResultSummary}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
