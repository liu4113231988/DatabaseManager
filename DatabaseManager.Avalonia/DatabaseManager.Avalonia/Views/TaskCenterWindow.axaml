<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:DatabaseManager.AppCore.ViewModels"
        xmlns:models="using:DatabaseManager.AppCore.Models"
        x:Class="DatabaseManager.Avalonia.Views.TaskCenterWindow"
        x:DataType="vm:TaskCenterViewModel"
        Title="任务中心"
        Width="920" Height="620"
        Icon="/Assets/database-manager.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Background="{DynamicResource AppWindowBgBrush}">

        <!-- 顶部标题区 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel Spacing="2">
                <TextBlock Text="任务中心" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="查看和取消本会话后台任务，跨会话历史记录可追溯执行结果与日志" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSubtleBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <atom:Button Content="刷新" Command="{Binding RefreshCommand}" />
                <atom:Button Content="取消选中任务" Command="{Binding CancelSelectedCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <atom:Button Classes="ghost" Content="关闭" Click="BtnClose_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppStatusBarBrush}" Padding="14,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="任务中心：本会话任务与跨会话历史记录；可取消运行中的查询、调度等操作。"
                           FontSize="11" Foreground="{DynamicResource AppStatusBarTextBrush}" />
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <TabControl Margin="16">
            <!-- 本会话任务 -->
            <TabItem Header="本会话任务">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Runs}"
                              SelectedItem="{Binding SelectedRun}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              CanUserResizeColumns="True" FontSize="11"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="80" />
                            <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAtText}" Width="80" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="70" />
                            <DataGridTextColumn Header="进度/结果" Binding="{Binding ResultSummary}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="6" Background="{DynamicResource AppDividerBrush}" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="任务日志" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,4" />
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Background="{DynamicResource AppSurfaceBrush}">
                            <atom:TextBox Text="{Binding SelectedRunLogs, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 历史记录 -->
            <TabItem Header="历史记录" IsVisible="{Binding HasHistory}">
                <Grid RowDefinitions="*,180">
                <DataGrid Margin="0,0,0,8" ItemsSource="{Binding History}"
                          SelectedItem="{Binding SelectedHistory}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          CanUserResizeColumns="True" FontSize="11"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90" />
                        <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt, StringFormat='MM-dd HH:mm:ss'}" Width="120" />
                        <DataGridTextColumn Header="结果" Binding="{Binding ResultSummary}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
                <atom:TextBox Grid.Row="1" Text="{Binding SelectedHistory.LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" />
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
